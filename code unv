File start.js rusak saat di-copy (ada karakter ur tambahan). Buat ulang dengan cara yang lebih aman:

docker exec cbt-frontend sh -c "cat > /app/start.js" << 'EOF'
const http = require('http');
const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');
const PORT = parseInt(process.env.PORT || '3000', 10);
const BUILD_DIR = path.join(__dirname, 'build');
const INDEX_FILE = path.join(BUILD_DIR, 'index.html');
const MIME = {'.html':'text/html; charset=utf-8','.js':'text/javascript','.css':'text/css','.json':'application/json','.png':'image/png','.jpg':'image/jpeg','.jpeg':'image/jpeg','.gif':'image/gif','.svg':'image/svg+xml','.ico':'image/x-icon','.woff':'font/woff','.woff2':'font/woff2','.ttf':'font/ttf','.webp':'image/webp','.map':'application/json','.txt':'text/plain','.webmanifest':'application/manifest+json'};
function serveFile(res, fp) {
  fs.readFile(fp, (err, data) => {
    if (err) {
      if (fs.existsSync(INDEX_FILE)) {
        fs.readFile(INDEX_FILE, (e2, d) => { res.writeHead(200, {'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-cache'}); res.end(e2 ? '<p>Loading...</p>' : d); });
      } else { res.writeHead(200, {'Content-Type':'text/html'}); res.end('<p>Building...</p>'); }
      return;
    }
    const ext = path.extname(fp).toLowerCase();
    const h = {'Content-Type': MIME[ext] || 'application/octet-stream'};
    if (fp.includes('/static/')) h['Cache-Control'] = 'public, max-age=31536000, immutable';
    res.writeHead(200, h); res.end(data);
  });
}
const server = http.createServer((req, res) => {
  const u = req.url.split('?')[0];
  if (u === '/health') { res.writeHead(200); res.end('{"status":"ok"}'); return; }
  if (u === '/' || u === '') { serveFile(res, INDEX_FILE); return; }
  const fp = path.join(BUILD_DIR, u);
  if (!fp.startsWith(BUILD_DIR)) { res.writeHead(403); res.end('Forbidden'); return; }
  serveFile(res, fp);
});
server.listen(PORT, '0.0.0.0', () => {
  console.log('[FRONTEND] Server on port ' + PORT);
  if (!fs.existsSync(INDEX_FILE)) {
    console.log('[FRONTEND] Building...');
    const b = spawn('npx', ['craco', 'build'], { cwd: __dirname, stdio: 'inherit', env: Object.assign({}, process.env, {NODE_OPTIONS: '--max-old-space-size=1536'}) });
    b.on('exit', (c) => console.log(c === 0 ? '[FRONTEND] Build done!' : '[FRONTEND] Build failed'));
  } else { console.log('[FRONTEND] Serving from ' + BUILD_DIR); }
});
server.on('error', (e) => { if (e.code === 'EADDRINUSE') setTimeout(() => { server.close(); server.listen(PORT, '0.0.0.0'); }, 3000); else process.exit(1); });
EOF
